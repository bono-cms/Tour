<?php

use Krystal\Widget\GridView\GridViewWidget;
use Krystal\Form\Element;
use Cms\View\Icon;

?>

<div class="btn-toolbar mb-3">
    <div class="btn-group me-2">
        <a class="btn btn-primary" href="<?= $this->url('Tour:Admin:Hotel@addAction'); ?>"><?= $this->translate('Add new hotel'); ?></a>
    </div>
</div>

<div class="card card-body">
    <form autocomplete="off">
        <?= $this->widget(new GridViewWidget($hotels, [
            'tableClass' => 'table table-hover table-bordered table-striped table-sm',
            'columns' => [
                [
                    'column' => 'id',
                    'label' => '#'
                ],

                [
                    'column' => 'cover',
                    'value' => function($entity){
                        return Element::image($entity->getImageUrl('400x400'), ['class' => 'img-fluid']);
                    }
                ],

                [
                    'column' => 'name',
                ],

                [
                    'column' => 'address',
                ],
                
                [
                    'column' => 'phone'
                ]
            ],

            'actions' => [
                function($row){
                    return Icon::view($row['url'], $this->translate('View this hotel on site'));
                },

                function($row){
                    return Icon::edit(
                        $this->url('Tour:Admin:Hotel@editAction', $row['id']),
                        $this->translate('Edit this hotel')
                    );
                },

                function($row){
                    return Icon::remove(
                        $this->url('Tour:Admin:Hotel@deleteAction', $row['id']),
                        $this->translate('Delete this hotel')
                    );
                }
            ]
        ])); ?>
    </form>
</div>