<?php

use Krystal\Widget\GridView\GridViewWidget;
use Krystal\Form\Element;
use Cms\View\Icon;

?>

<form autocomplete="off">
    <div class="btn-toolbar mb-3">
        <div class="btn-group me-2">
            <?php $this->loadPartial('menu', [
                'notifications' => $newReviews,
                'items' => [
                    'Tour:Admin:Tour@addAction' => 'Add a tour',
                    'Tour:Admin:Category@addAction' => 'Add category',
                    'Tour:Admin:Booking@indexAction' => 'Bookings',
                    'Tour:Admin:Hotel@indexAction' => 'Hotels',
                    'Tour:Admin:TourDestination@indexAction' => 'Tour destinations',
                    'Tour:Admin:TourReview@indexAction' => [
                        'caption' => 'Reviews',
                        'notifications' => $newReviews
                    ]
                ],

                'actions' => [
                    'data' => $tours,
                    'delete' => 'Tour:Admin:Tour@deleteAction'
                ]
            ]); ?>
        </div>

        <div class="btn-group me-2">
            <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> <?= $this->translate('Filter'); ?></button>
        </div>
    </div>

    <div class="card card-body">
        <?php $this->loadPartial('items-per-page', ['caption' => 'Tours']); ?>

        <?= $this->widget(new GridViewWidget($tours, [
            'pk' => 'id',
            'batch' => true,
            'tableClass' => 'table table-hover table-bordered table-striped',
            'columns' => [
                [
                    'column' => 'id',
                    'label' => '#'
                ],

                [
                    'column' => 'name',
                    'filter' => true
                ],

                [
                    'column' => 'category',
                    'name' => 'category_id',
                    'type' => 'select',
                    'filter' => $categoryList,
                    'value' => function($row){
                        return $row['categories'];
                    }
                ],

                [
                    'column' => 'adults',
                    'filter' => true,
                    'label' => 'Number of adults'
                ],

                [
                    'column' => 'order'
                ],

                [
                    'column' => 'published',
                    'type' => 'select',
                    'filter' => 'boolean',
                    'translateable' => true,
                    'value' => function($row){
                        return $row['published'] ? 'Yes' : 'No';
                    }
                ]
            ],

            'actions' => [
                function($row){
                    return Icon::view($row->getUrl(), $this->translate('View this tour on site'));
                },

                function($row){
                    return Icon::edit(
                        $this->url('Tour:Admin:Tour@editAction', $row['id']),
                        $this->translate('Edit this tour')
                    );
                },

                function($row){
                    return Icon::remove(
                        $this->url('Tour:Admin:Tour@deleteAction', $row['id']),
                        $this->translate('Remove this tour')
                    );
                }
            ]

        ])); ?>

        <?php $this->loadPartial('paginator'); ?>

        <?php if (empty($tours)): ?>
        <div class="center-block">
            <h2 class="text-center text-muted"><i class="bi bi-x"></i> <?= $this->translate('No tours'); ?></h2>
        </div>
        <?php endif; ?>
    </div>

    <div class="card card-body">
        <h2><i class="bi bi-folder2-open"></i> <?= $this->translate('Categories'); ?> <small>(<?= count($categories); ?>)</small></h2>

        <?= $this->widget(new GridViewWidget($categories, [
            'pk' => 'id',
            'batch' => false,
            'tableClass' => 'table table-hover table-bordered table-striped',
            'columns' => [
                [
                    'column' => 'id',
                    'label' => '#'
                ],

                [
                    'column' => 'name',
                ],

                [
                    'column' => 'tour_count'
                ]
            ],

            'actions' => [
                function($row){
                    return Icon::view($row->getUrl(), $this->translate('View this category on site'));
                },

                function($row){
                    return Icon::edit($this->url('Tour:Admin:Category@editAction', $row['id']), $this->translate('Edit this category'));
                },

                function($row){
                    return Icon::remove($this->url('Tour:Admin:Category@deleteAction', $row['id']), $this->translate('Remove this category'));
                }
            ]
        ])); ?>

        <?php if (empty($categories)): ?>
        <div class="center-block">
            <h2 class="text-center text-muted"><i class="bi bi-x"></i> <?= $this->translate('No categories'); ?></h2>
        </div>
        <?php endif; ?>
    </div>

</form>